    "lint:prettier": "prettier . --cache --write"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.6.0",
    "@tofrankie/eslint": "^0.5.0",
    "eslint": "^10.8.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "./extensions/*"
  ]
}
