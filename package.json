{
  "name": "raycast-extension-collection",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "description": "Raycast extension collectioni",
  "author": "",
  "license": "MIT",
  "homepage": "https://www.raycast.com/tofrankie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tofrankie/raycast-extension-collection.git"
  },
  "bugs": {
    "url": "https://github.com/tofrankie/raycast-extension-collection/issues"
  },
  "scripts": {
    "lint": "run-s lint:eslint lint:pkgs:fix lint:prettier",
    "lint:eslint": "eslint --config ./eslint.config.js '**/package.json' --cache --fix",
    "lint:pkgs": "npm run lint --workspaces --if-present",
